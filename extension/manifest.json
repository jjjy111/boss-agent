{
  "manifest_version": 3,
  "name": "BOSS - Agent · BOSS 采集器",
  "version": "1.3.0",
  "description": "采集用户可查看的 BOSS 岗位并写入本地求职工作台，不代发任何消息。",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BOSS - Agent 岗位采集器"
  }
}
